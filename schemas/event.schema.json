{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelmap.dev/schemas/event.schema.json",
  "title": "ModelMap Event",
  "type": "object",
  "required": ["id", "type", "name", "event_type", "subject", "occurred_at", "evidence"],
  "properties": {
    "id": {"type": "string", "pattern": "^event:[a-z0-9][a-z0-9._-]*$"},
    "type": {"const": "event"},
    "name": {"type": "string", "minLength": 1},
    "event_type": {
      "type": "string",
      "enum": [
        "technique_introduced",
        "paper_published",
        "report_published",
        "model_announced",
        "weights_released",
        "api_released",
        "code_released",
        "dataset_released",
        "license_changed",
        "checkpoint_updated",
        "context_extended",
        "benchmark_published",
        "model_deprecated",
        "training_completed",
        "organization_founded"
      ]
    },
    "subject": {"type": "string", "minLength": 3},
    "occurred_at": {"type": "string", "format": "date"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^source:[a-z0-9][a-z0-9._-]*$"}
    },
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
