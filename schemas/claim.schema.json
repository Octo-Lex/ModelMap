{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelmap.dev/schemas/claim.schema.json",
  "title": "ModelMap Claim",
  "type": "object",
  "required": ["id", "type", "subject", "predicate", "status", "evidence"],
  "properties": {
    "id": {"type": "string", "pattern": "^claim:[a-z0-9][a-z0-9._-]*$"},
    "type": {"const": "claim"},
    "subject": {"type": "string", "minLength": 3},
    "predicate": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "object": {"type": "string", "minLength": 3},
    "value": {},
    "status": {
      "type": "string",
      "enum": [
        "confirmed_primary",
        "reported_primary",
        "independently_verified",
        "inferred",
        "disputed",
        "superseded",
        "unknown"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source"],
        "properties": {
          "source": {"type": "string", "pattern": "^source:[a-z0-9][a-z0-9._-]*$"},
          "locator": {"type": ["string", "null"]},
          "note": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "valid_from": {"type": ["string", "null"], "format": "date"},
    "valid_to": {"type": ["string", "null"], "format": "date"},
    "notes": {"type": ["string", "null"]}
  },
  "oneOf": [
    {"required": ["object"], "not": {"required": ["value"]}},
    {"required": ["value"], "not": {"required": ["object"]}}
  ],
  "allOf": [
    {
      "if": {
        "properties": {"status": {"enum": ["inferred", "unknown"]}},
        "required": ["status"]
      },
      "then": {},
      "else": {"properties": {"evidence": {"minItems": 1}}}
    }
  ],
  "additionalProperties": false
}
