{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelmap.dev/schemas/source.schema.json",
  "title": "ModelMap Source",
  "type": "object",
  "required": ["id", "type", "title", "source_type", "url"],
  "properties": {
    "id": {"type": "string", "pattern": "^source:[a-z0-9][a-z0-9._-]*$"},
    "type": {"const": "source"},
    "title": {"type": "string", "minLength": 1},
    "source_type": {
      "type": "string",
      "enum": [
        "paper",
        "technical_report",
        "model_card",
        "official_config",
        "official_repository",
        "official_announcement",
        "engineering_note",
        "benchmark_report",
        "dataset_card",
        "independent_reproduction",
        "interview",
        "secondary_analysis",
        "community_discussion"
      ]
    },
    "url": {"type": "string", "format": "uri"},
    "authors": {"type": "array", "items": {"type": "string"}, "default": []},
    "publisher": {"type": ["string", "null"]},
    "published_at": {"type": ["string", "null"], "format": "date"},
    "version": {"type": ["string", "null"]},
    "retrieved_at": {"type": ["string", "null"], "format": "date-time"},
    "archive_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
