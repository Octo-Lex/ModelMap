{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelmap.dev/schemas/year-view.schema.json",
  "title": "ModelMap Generated Year View",
  "type": "object",
  "required": ["year", "generated_from", "events"],
  "properties": {
    "year": {"type": "integer", "minimum": 2017},
    "generated_from": {"const": "canonical-events"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name", "event_type", "subject", "occurred_at", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^event:[a-z0-9][a-z0-9._-]*$"},
          "type": {"const": "event"},
          "name": {"type": "string", "minLength": 1},
          "event_type": {"type": "string", "minLength": 1},
          "subject": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._-]*$"},
          "occurred_at": {"type": "string", "format": "date"},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^source:[a-z0-9][a-z0-9._-]*$"}
          },
          "notes": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
