{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelmap.dev/schemas/year-view.schema.json",
  "title": "ModelMap Generated Year View",
  "type": "object",
  "$defs": {
    "canonicalId": {
      "type": "string",
      "pattern": "^(?:family|release|variant|arch|technique|training|implementation|paper|source|claim|relationship|event|dataset|dataset-version|benchmark|benchmark-version|eval-protocol|eval-run|org|person|license|hardware|product):[a-z0-9][a-z0-9._-]*$"
    },
    "event": {
      "type": "object",
      "required": ["id", "type", "name", "event_type", "subject", "occurred_at", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^event:[a-z0-9][a-z0-9._-]*$"},
        "type": {"const": "event"},
        "name": {"type": "string", "minLength": 1},
        "event_type": {
          "type": "string",
          "enum": [
            "technique_introduced",
            "paper_published",
            "report_published",
            "model_announced",
            "weights_released",
            "api_released",
            "code_released",
            "dataset_released",
            "license_changed",
            "checkpoint_updated",
            "context_extended",
            "benchmark_published",
            "model_deprecated",
            "training_completed",
            "organization_founded",
            "access_suspended",
            "access_restored"
          ]
        },
        "subject": {"$ref": "#/$defs/canonicalId"},
        "occurred_at": {"type": "string", "format": "date"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^source:[a-z0-9][a-z0-9._-]*$"}
        },
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "required": ["year", "generated_from", "events"],
  "properties": {
    "year": {"type": "integer", "minimum": 2017},
    "generated_from": {"const": "canonical-events"},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
  },
  "additionalProperties": false
}
